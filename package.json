{
  "name": "@agent-harness/core",
  "version": "1.0.0",
  "description": "Agent Harness - A production-grade AI Agent runtime framework based on Systems Theory, Cybernetics, and Information Theory",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "agents/",
    "config/",
    "constraints/",
    "tools/",
    "skills/",
    "telemetry/",
    "monitoring/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-agent",
    "multi-agent",
    "agent-framework",
    "langgraph",
    "orchestration",
    "systems-theory",
    "cybernetics",
    "information-theory"
  ],
  "author": "Agent Harness Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cybernetix-lab/harness-spec.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "eslint": "^8.55.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./agents": {
      "import": "./dist/agents/index.js",
      "types": "./dist/agents/index.d.ts"
    },
    "./orchestration": {
      "import": "./dist/orchestration/index.js",
      "types": "./dist/orchestration/index.d.ts"
    },
    "./memory": {
      "import": "./dist/memory/index.js",
      "types": "./dist/memory/index.d.ts"
    },
    "./telemetry": {
      "import": "./dist/telemetry/index.js",
      "types": "./dist/telemetry/index.d.ts"
    },
    "./skills": {
      "import": "./dist/skills/index.js",
      "types": "./dist/skills/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    }
  }
}
